# Paths
SQLITE_PATH=data/digest.db
OUTPUT_DIR=output
ITEMS_DIR=data/items

# Qdrant: use Docker Compose below, or point to an existing Qdrant instance.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=ai_developments

# Local embeddings; first run downloads the model from Hugging Face.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
SEMANTIC_DUPLICATE_THRESHOLD=0.93
SEMANTIC_SEARCH_LIMIT=5

# Collection policy. Initial run only ingests recent entries; later runs are safe to repeat.
LOOKBACK_HOURS=168
MAX_ITEMS_PER_FEED=60
REQUEST_TIMEOUT_SECONDS=25
USER_AGENT=AI-Developments-Digest/0.1 (+personal research project)

# Story Clustering
STORY_CLUSTERING_ENABLED=true
STORY_CLUSTER_TOP_K=10
STORY_CLUSTER_SIMILARITY_THRESHOLD=0.85
STORY_CLUSTER_MAX_AGE_DAYS=30
STORY_CLUSTER_MAX_ARTICLES=10
STORY_CLUSTER_MAX_CONTEXT_CHARS=30000
STORY_CLUSTER_AMBIGUITY_MARGIN=0.03

# LLM: the first version supports Ollama's local HTTP API.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=180
MAX_ARTICLES_PER_LLM_BATCH=10
MAX_ARTICLE_CHARS=5000
